{
  "source_policy": {
    "purpose": "Use high-quality RSS feeds as discovery signals for original, cited WordPress posts about science breakthroughs, space, phones, iPhone/iOS, Android, gadgets, AI, software/apps, innovation, tutorials, security, DIY, practical hacks, health research, public policy, politics, world affairs, diplomacy, celebrity news, entertainment, culture, gaming, future mobility & EVs, fintech & crypto, clean energy, and aerospace & defense tech.",
    "rules": [
      "Create original synthesis from multiple sources; do not republish or lightly spin feed text.",
      "Use source titles, summaries, dates, and links as inputs unless the source explicitly allows broader reuse.",
      "Use natural inline attribution with visible source links where the reporting comes from outside sources.",
      "Skip paywalled, single-source, thin, or duplicate stories.",
      "If a source's RSS terms are restrictive, use it only as a topic alert or disable it until reviewed.",
      "Health and medical content requires extra scrutiny: verify claims, cite peer-reviewed sources when possible, and include appropriate disclaimers.",
      "Political, celebrity, and world-news coverage should follow the same original reporting standard: verify the claim, cite the source, and favor depth over rumor or recycled gossip.",
      "Gaming, mobility, crypto, energy, defense, and political reporting must adhere to the same strict professional human-written journalism standard: original synthesis, active voice, factual precision, zero AI fluff or promotional hype, and natural attribution."
    ]
  },
